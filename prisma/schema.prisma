generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  READER
  CREATOR
  ADMIN
}

enum CreatorApplicationStatus {
  NOT_APPLIED
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                       String                   @id @default(cuid())
  supabaseUserId           String                   @unique @db.Uuid
  email                    String                   @unique @db.VarChar(320)
  role                     UserRole                 @default(READER)
  creatorApplicationStatus CreatorApplicationStatus @default(NOT_APPLIED)
  emailVerifiedAt          DateTime?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  @@index([role])
  @@index([creatorApplicationStatus])
}
